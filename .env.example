# Alpha Trader Environment Configuration
# Copy this file to .env and fill in your credentials.
# NEVER commit .env to source control.

# ─── Dashboard ───
DEXTER_WEB_PASSWORD=alpha2026

# ─── LLM / AI Brain ───
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
KIMI_API_KEY=
MOONSHOT_API_KEY=
LLM_PROVIDER=openai
BROWSER_USE_MODEL=gpt-4o

# ─── Telegram Alerts ───
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── Broker / Venue Credentials ───
SCHWAB_APP_KEY=
SCHWAB_APP_SECRET=
SCHWAB_REDIRECT_URI=https://localhost:8080/callback

OANDA_API_KEY=
OANDA_ACCOUNT_ID=

KALSHI_API_KEY=
KALSHI_API_SECRET=

TOPSTEP_USERNAME=
TOPSTEP_PASSWORD=

# Apex Trader Funding (browser automation)
APEX_USERNAME=
APEX_PASSWORD=

# Apex Funded Futures API (optional, used when venue=apex/apexfutures)
APEXFUTURES_API_KEY=
APEXFUTURES_ACCOUNT_ID=
APEXFUTURES_BASE_URL=https://api.apexfutures.com
APEX_MAX_CONTRACTS=5
APEX_MAX_DAILY_LOSS=2000

# Apex / Tradovate API (recommended for funded futures)
# Set these to trade Apex accounts through the Tradovate REST API.
TRADOVATE_USERNAME=
TRADOVATE_PASSWORD=
TRADOVATE_ACCOUNT_ID=
TRADOVATE_ACCOUNT_SPEC=
TRADOVATE_APP_ID=AlphaTrader
TRADOVATE_APP_VERSION=1.0
TRADOVATE_DEVICE_ID=alphatrader-device-001
TRADOVATE_CID=
TRADOVATE_SEC=
TRADOVATE_DEMO=true

TRADINGVIEW_USERNAME=
TRADINGVIEW_PASSWORD=

# ─── Market Data APIs ───
MASSIVE_API_KEY=
UNUSUAL_WHALES_API_KEY=
ALPHA_VANTAGE_API_KEY=
NEWS_API_KEY=
MARKETAUX_API_TOKEN=

# ─── Webhooks / Security ───
TRADINGVIEW_WEBHOOK_SECRET=

# ─── Solana / Crypto ───
SOLANA_PRIVATE_KEY=

# ─── Runtime Tuning ───
ALPHA_TRADER_DRY_RUN=true
ALPHA_TRADER_AUTO_START=false
ALPHA_TRADER_AUDIT_DB_PATH=data/audit/audit_ledger.db
